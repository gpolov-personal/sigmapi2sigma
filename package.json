{
  "name": "sigmapi2sigma",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k --kill-signal SIGTERM -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx server/index.ts",
    "dev:web": "vite",
    "stop": "fuser -k 5173/tcp 5174/tcp 2>/dev/null; pkill -f 'tsx .*server/index' 2>/dev/null; pkill -f 'vite' 2>/dev/null; echo stopped",
    "build:web": "vite build",
    "install-cron": "bash scripts/install-cron.sh",
    "uninstall-cron": "bash scripts/uninstall-cron.sh",
    "install-shell-hook": "bash scripts/install-shell-hook.sh",
    "uninstall-shell-hook": "bash scripts/uninstall-shell-hook.sh",
    "snapshot": "bash scripts/snapshot.sh",
    "restore": "bash scripts/restore.sh",
    "backup": "bash scripts/backup.sh",
    "restore-backup": "bash scripts/restore-backup.sh"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^1.14.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
